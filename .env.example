# ─────────────────────────────────────────────────────────────
# Local Prospect Finder – Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────
POSTGRES_USER=lpf
POSTGRES_PASSWORD=lpfpassword
POSTGRES_DB=local_prospect_finder
DATABASE_URL=postgresql+asyncpg://lpf:lpfpassword@localhost:5432/local_prospect_finder

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Google APIs ───────────────────────────────────────────────
# Required for business discovery (Google Places API v1 New)
# Enable at: https://console.cloud.google.com > APIs > Places API (New)
GOOGLE_PLACES_API_KEY=

# Optional but recommended: improves PageSpeed Insights quota
# Enable at: https://console.cloud.google.com > APIs > PageSpeed Insights API
PAGESPEED_API_KEY=

# ── Wappalyzer API ────────────────────────────────────────────
# Optional: enables accurate tech stack detection via Wappalyzer
# Get key at: https://www.wappalyzer.com/api/
# If not set, falls back to HTML pattern matching
WAPPALYZER_API_KEY=

# ── App ───────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-64-char-secret
ENVIRONMENT=development

# ── Frontend ──────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
